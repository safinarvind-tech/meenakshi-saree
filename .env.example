# ── Database (PostgreSQL) ─────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/srimeenakshi?schema=public"

# ── Security ──────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── First admin (owner) account, created by `npx prisma db seed` ──
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="Store Owner"

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Where uploaded product photos are stored (mount a persistent volume here in production)
STORAGE_DIR="./storage"

# ── Razorpay (leave empty to offer Cash on Delivery only) ──
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) until launch.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → URL https://YOUR-DOMAIN/api/razorpay/webhook, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=""

# ── Product photo storage (free hosting) ──
# Leave empty to store photos on the server's disk (local dev, or a VPS with a volume at /app/storage).
# On Render's free plan the disk is wiped on restart, so use Supabase Storage (free 1 GB):
#   Supabase → Storage → New bucket "products" (Public) · Project Settings → API Keys → secret key
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="products"
